NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL pública donde vive el sitio (usada para armar el link de confirmación
# de email al registrarse y las URLs de vuelta de Mercado Pago). En local
# dejala como está; en Vercel poné la URL real del deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service role / secret key de Supabase. NUNCA lleva el prefijo NEXT_PUBLIC_
# (no debe llegar al navegador). La usa sólo el webhook de Mercado Pago.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Opcionales: sin esto la app funciona igual, sólo no se envían emails.
RESEND_API_KEY=
EMAIL_FROM="qrcartapp <notificaciones@tudominio.com>"
